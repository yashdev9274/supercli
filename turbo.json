{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ],
      "env": [
        "DATABASE_URL",
        "HOST",
        "INTEGRATION_CLIENT_ID",
        "INTEGRATION_CLIENT_SECRET",
        "MARKETPLACE_PRODUCT_SLUG",
        "PORT",
        "SUPERCODE_APP_URL"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "HOST",
    "INTEGRATION_CLIENT_ID",
    "INTEGRATION_CLIENT_SECRET",
    "MARKETPLACE_PRODUCT_SLUG",
    "PORT",
    "SUPERCODE_APP_URL"
  ]
}
