# ─── Database ───
DATABASE_URL=

# ─── Auth (Better-Auth) ───
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Terminal Client ───
# Where the billing studio lives (http://localhost:3000 for local dev,
# https://supercode-terminal.vercel.app in production).
NEXT_PUBLIC_TERMINAL_URL=

# ─── Secrets (Infisical) ───
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# ─── Voice / STT ───
# Primary STT provider (elevenlabs | groq). Default: elevenlabs
STT_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v1
STT_LANGUAGE=en

# Groq (parked — use STT_PROVIDER=groq to re-enable)
# GROQ_API_KEY=

# ─── AI Providers (CLI) ───
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
NVIDIA_API_KEY=

# ─── GitHub webhooks (code review) ───
# Public base URL GitHub can reach (not localhost). e.g. https://your-app.vercel.app
# Required so createWebhook can install https://…/api/webhooks/github
# NEXT_PUBLIC_APP_BASE_URL=
# Shared secret used when creating repo webhooks + verifying deliveries
GITHUB_WEBHOOK_SECRET=
# Merge.dev gateway (LLM + embeddings for reviews/indexing)
MERGE_GATEWAY_API_KEY=
PINECONE_DB_API_KEY=

# ─── Inngest (background AI reviews) ───
# Events: pr.review.requested (AI review + GitHub comment), repository-connected (index).
# Serve path: /api/inngest
#
# Production / Vercel:
#   INNGEST_EVENT_KEY=...   (from https://app.inngest.com → manage keys)
#   INNGEST_SIGNING_KEY=...
#   Sync the Inngest app to https://YOUR_DOMAIN/api/inngest
#
# Local development — pick ONE:
#   A) Easiest (no Inngest): omit all INNGEST_* vars.
#      Reviews run via Next.js after() in-process.
#   B) Local Inngest Dev Server:
#      1. npx inngest-cli@latest dev
#      2. INNGEST_DEV=1
#      Do NOT rely on cloud keys alone locally — cloud will accept events
#      but nothing runs them unless the cloud app is synced to a public URL,
#      which leaves reviews stuck in "pending".
# INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ─── Composio (Slack + Linear integrations) ───
# OAuth for Slack/Linear is hosted by Composio. Tokens never hit our DB.
# Callback URLs used by this app (add as allowed redirects in Composio if required):
#   {BETTER_AUTH_URL}/api/integrations/slack/callback
#   {BETTER_AUTH_URL}/api/integrations/linear/callback
COMPOSIO_API_KEY=
# Optional: pin auth configs from the SAME Composio project as COMPOSIO_API_KEY (ac_...).
# If unset OR the id 404s (Auth_Config_NotFound), connect lists/creates a Composio-managed
# auth config for the toolkit, then uses connectedAccounts.link with our callback URL.
# COMPOSIO_SLACK_AUTH_CONFIG_ID=
# COMPOSIO_LINEAR_AUTH_CONFIG_ID=
# Toolkit version required by tools.execute (defaults to "latest" if unset).
# COMPOSIO_TOOLKIT_VERSION=latest
# COMPOSIO_TOOLKIT_VERSION_LINEAR=latest
# COMPOSIO_TOOLKIT_VERSION_SLACK=latest
