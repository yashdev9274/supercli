# ─── Database ───
DATABASE_URL=

# ─── Auth (Better-Auth) ───
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Terminal Client ───
# Where the billing studio lives (http://localhost:3000 for local dev,
# https://supercode-terminal.vercel.app in production).
NEXT_PUBLIC_TERMINAL_URL=

# ─── Secrets (Infisical) ───
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# ─── Voice / STT ───
# Primary STT provider (elevenlabs | groq). Default: elevenlabs
STT_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v1
STT_LANGUAGE=en

# Groq (parked — use STT_PROVIDER=groq to re-enable)
# GROQ_API_KEY=

# ─── AI Providers (CLI) ───
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
NVIDIA_API_KEY=

# ─── GitHub webhooks (code review) ───
# Public base URL GitHub can reach (not localhost).
# Used by createWebhook → {BASE}/api/webhooks/github
#
# Production (recommended):
#   NEXT_PUBLIC_APP_BASE_URL=https://supercodeai.vercel.app
#   (NOT https://supercli.vercel.app — that host 307-redirects and breaks hooks)
# Local tunnel (only while ngrok/cloudflared is running):
#   NEXT_PUBLIC_APP_BASE_URL=https://xxxx.ngrok-free.app
#
# After changing this, reconnect repos (or update each GitHub webhook URL)
# so deliveries hit the new host. Stale ngrok URLs = silent no-reviews in prod.
# NEXT_PUBLIC_APP_BASE_URL=
# Shared secret used when creating repo webhooks + verifying deliveries
# Must match production Vercel env AND the secret on each GitHub webhook.
GITHUB_WEBHOOK_SECRET=
# ─── AI Gateway (PR reviews + embeddings) ───
# Primary: Vercel AI Gateway. Fallback: Merge (kept; free tier has model limits).
# Get a key: https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# Optional force: vercel | merge  (default: vercel if AI_GATEWAY_API_KEY set, else merge)
# AI_GATEWAY_PROVIDER=vercel
# Review chat model(s). Comma-separated = try in order across providers.
# REVIEW_MODEL=anthropic/claude-sonnet-4.5,openai/gpt-4.1-mini
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.5
# Merge.dev gateway (fallback / legacy)
MERGE_GATEWAY_API_KEY=
# MERGE_GATEWAY_MODEL=google/gemini-2.5-flash-lite
PINECONE_DB_API_KEY=

# ─── Inngest (background AI reviews) ───
# Events: pr.review.requested (AI review + GitHub comment), repository-connected (index).
# Serve path: /api/inngest  (must be reachable WITHOUT redirects)
#
# Production / Vercel checklist:
#   1. INNGEST_EVENT_KEY + INNGEST_SIGNING_KEY on the Vercel project
#      (https://app.inngest.com → your app → Manage keys)
#   2. Sync / register the Inngest app to the canonical host, e.g.
#        https://supercodeai.vercel.app/api/inngest
#      or https://www.supercodeai.tech/api/inngest
#      Never point Inngest at a 307/308 alias (supercli.vercel.app redirects).
#   3. Local `npx inngest-cli dev` does NOT process production events.
#      Production webhooks → Vercel → inngest.send → Inngest Cloud →
#      POST back to /api/inngest on Vercel. Your laptop is not in that loop.
#   4. GitHub repo webhook URL must be the production host (step 2 domain),
#      with the same GITHUB_WEBHOOK_SECRET as Vercel.
#
# Local development — pick ONE:
#   A) Easiest (no Inngest): omit all INNGEST_* vars.
#      Reviews run via Next.js after() in-process.
#   B) Local Inngest Dev Server:
#      1. npx inngest-cli@latest dev
#      2. INNGEST_DEV=1
#      3. Do NOT set cloud INNGEST_EVENT_KEY without INNGEST_DEV=1
#         (cloud accepts events; nothing runs → stuck "pending").
# INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ─── Composio (Slack + Linear integrations) ───
# OAuth for Slack/Linear is hosted by Composio. Tokens never hit our DB.
# Callback URLs used by this app (add as allowed redirects in Composio if required):
#   {BETTER_AUTH_URL}/api/integrations/slack/callback
#   {BETTER_AUTH_URL}/api/integrations/linear/callback
COMPOSIO_API_KEY=
# Optional: pin auth configs from the SAME Composio project as COMPOSIO_API_KEY (ac_...).
# If unset OR the id 404s (Auth_Config_NotFound), connect lists/creates a Composio-managed
# auth config for the toolkit, then uses connectedAccounts.link with our callback URL.
# COMPOSIO_SLACK_AUTH_CONFIG_ID=
# COMPOSIO_LINEAR_AUTH_CONFIG_ID=
# Toolkit version required by tools.execute (defaults to "latest" if unset).
# COMPOSIO_TOOLKIT_VERSION=latest
# COMPOSIO_TOOLKIT_VERSION_LINEAR=latest
# COMPOSIO_TOOLKIT_VERSION_SLACK=latest

# ─── Resend (PR review emails) ───
# Send a summary email to the connected Supercode user when a PR review completes.
# Create an API key at https://resend.com/api-keys and verify your domain.
RESEND_API_KEY=
# From address — must be a verified domain in production.
# Example: Supercode <reviews@supercodeai.tech>
RESEND_FROM=Supercode <onboarding@resend.dev>
# Optional: published Resend template id (pr-review-complete). If unset, inline HTML is used.
RESEND_PR_REVIEW_TEMPLATE_ID=61b63f0c-d5a3-4f4a-ae5c-49206b887825
# Dashboard base for "Open in dashboard" CTA (no trailing slash)
NEXT_PUBLIC_DASHBOARD_URL=https://supercodeai.vercel.app/dashboard
# Product / code-review landing shown in email footer
NEXT_PUBLIC_CODE_REVIEW_URL=https://supercodeai.tech/code-review

