# ─── Database ───
DATABASE_URL=

# ─── Auth (Better-Auth) ───
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Terminal Client ───
# Where the billing studio lives (http://localhost:3000 for local dev,
# https://supercode-terminal.vercel.app in production).
NEXT_PUBLIC_TERMINAL_URL=

# ─── Secrets (Infisical) ───
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# ─── Voice / STT ───
# Primary STT provider (elevenlabs | groq). Default: elevenlabs
STT_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v1
STT_LANGUAGE=en

# Groq (parked — use STT_PROVIDER=groq to re-enable)
# GROQ_API_KEY=

# ─── AI Providers (CLI) ───
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
NVIDIA_API_KEY=

# ─── GitHub webhooks (code review) ───
# Public base URL GitHub can reach (not localhost). e.g. https://your-app.vercel.app
# NEXT_PUBLIC_APP_BASE_URL=
# Shared secret used when creating repo webhooks + verifying deliveries
GITHUB_WEBHOOK_SECRET=
# Merge.dev gateway (LLM + embeddings for reviews/indexing)
MERGE_GATEWAY_API_KEY=
PINECONE_DB_API_KEY=
