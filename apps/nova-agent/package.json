{
  "name": "@super/nova-agent",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "eve dev --no-ui",
    "build": "eve build",
    "start": "eve start --host 127.0.0.1",
    "test": "bun test tests/*.test.ts",
    "test:runtime": "cd tests/fixtures/runtime && eve eval --strict",
    "test:codex": "cd tests/fixtures/codex && eve eval --strict",
    "test:compatible": "cd tests/fixtures/compatible && eve eval --strict",
    "test:anthropic": "cd tests/fixtures/anthropic && eve eval --strict",
    "test:repository": "cd tests/fixtures/repository && eve eval --strict",
    "test:security": "bun run build && node --test tests/workflow-security.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@super/nova-runtime": "workspace:*",
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@super/provider-runtime": "workspace:*",
    "@super/agent-runtime": "workspace:*",
    "@super/codex-runtime": "workspace:*",
    "@super/db": "workspace:*",
    "ai": "7.0.172",
    "eve": "1.3.0",
    "just-bash": "3.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.7.0"
  }
}
