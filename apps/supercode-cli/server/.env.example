# ──────────────────────────────────────────────
# Supercode CLI Server — Environment Variables
# ──────────────────────────────────────────────
# Copy this to .env and fill in your values.
#
# 🔴  Required — server won't start without it
# 🟡  Required for feature
# ⚪  Optional — skip if you don't need the feature
#
# ─── Database ──────────────────────────────────
# 🔴 PostgreSQL connection string
# Terminal server uses DATABASE_URL_TERMINAL first, falls back to DATABASE_URL
# Docker Desktop: postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_URL_TERMINAL="postgresql://postgres:postgres@localhost:5432/postgres"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# ─── Authentication (Better-Auth) ──────────────
# 🔴 Session encryption secret
BETTER_AUTH_SECRET=""
# 🔴 Server URL for auth flows
BETTER_AUTH_URL="http://localhost:3004"
# 🔴 Terminal frontend URL (used for CORS and redirects)
CLIENT_URL="http://localhost:3000"
# Dashboard origin used by the native desktop Supercode Review API proxy.
# Local: http://localhost:3001. Production: https://supercodeai.vercel.app
# Do not include /dashboard; API routes live at /api/desktop/reviews on this origin.
SUPERCODE_DASHBOARD_API_URL="http://localhost:3001"

# 🟡 GitHub OAuth — required to log in
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# ⚪ Override the GitHub OAuth redirect URI (defaults to
# https://supercode-terminal.vercel.app/api/auth/callback/github in production).
# Set for local dev if needed, or when the prod domain changes.
GITHUB_REDIRECT_URI=""

# ─── Server ────────────────────────────────────
# ⚪ Port (defaults to 10000 if unset)
PORT=10000
# 🔴 CLI auth URL (used by `supercode login`)
SUPERCODE_SERVER_URL="http://localhost:10000"
# ⚪ Default workspace root for file operations
SUPERCODE_WORKSPACE_ROOT=""

# ─── AI Providers ──────────────────────────────
# 🟡 At least one required for AI features

# Google / Gemini
GOOGLE_GENERATIVE_AI_API_KEY=""
MODEL1="gemini-2.5-flash"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="moonshotai/kimi-k2.6"
# ⚪ Optional: site identity sent with OpenRouter requests
OPENROUTER_SITE_URL=""
OPENROUTER_SITE_TITLE="supercode"

# Anthropic
ANTHROPIC_API_KEY=""

# NVIDIA
NVIDIA_API_KEY=""
NVIDIA_MODEL="minimaxai/minimax-m2.7"

# MiniMax
MINIMAX_API_KEY=""
MINIMAX_MODEL="MiniMax-M2"

# ConcentraceAI
CONCENTRATEAI_API_KEY=""

# Merge Dev Gateway (https://app.merge.dev)
MERGE_DEV_API_KEY=""
MERGE_DEV_MODEL="anthropic/claude-opus-4-8"

# ─── Web Search Tools ──────────────────────────
# 🟡 Required for search/scrape tools

# Google Custom Search
GOOGLE_API_KEY=""
GOOGLE_CSE_ID=""

# Firecrawl
FIRECRAWL_API_KEY=""

# ─── Voice / Speech-to-Text (STT) ──────────────
# Used by the CLI voice capture and POST /api/voice/transcribe.
# Voice capture uses Smallest.ai (Pulse STT) exclusively.
STT_PROVIDER="smallest"
STT_LANGUAGE="en"

# Smallest.ai (Pulse STT) — https://app.smallest.ai/dashboard/api-keys
SMALLEST_API_KEY=""
# "pulse-pro" (best English accuracy) or "pulse" (multilingual) by default
SMALLEST_MODEL="pulse-pro"
SMALLEST_LANGUAGE="en"

# ─── Voice / Web search (Jarvis voice agent) ────
# Jarvis may use Context.dev, Exa, or Firecrawl for web search depending on the
# request. context.dev/exa try the provider the model picked then fall back to
# the other. CONTEXTDEV_API_KEY is accepted as a legacy alias for Context.dev.
CONTEXT_DEV_API_KEY=""
EXA_API_KEY=""
FIRECRAWL_API_KEY=""

# ─── Voice / Text-to-Speech (TTS / spoken reply) ────
# The CLI speaks the assistant's answer aloud after a voice-triggered turn
# (Clicky-style). ElevenLabs TTS when ELEVENLABS_API_KEY is set, otherwise the
# built-in macOS `say` voice. Requires macOS for audio playback.
# Set VOICE_REPLY="off" to disable spoken replies entirely.
VOICE_REPLY="on"
# Voice used for ElevenLabs TTS
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
# "eleven_turbo_v2_5" (low latency) by default
ELEVENLABS_TTS_MODEL=""

# ─── Jarvis wake-work agent ─────────────────────
# ⚪ Optional. When voice input (or /jarvis) is triggered, the CLI launches
# these daily apps. WhatsApp opens in the native macOS desktop app; everything
# else opens in the browser named by JARVIS_BROWSER (default "Dia") rather than
# the OS default. Set the Slack/Linear URLs to your real workspace URLs;
# JARVIS_URLS is a comma-separated list of extra apps.
JARVIS_WAKE_PHRASE="jarvis wake up,jarvis wakeup,jarvis"
# Browser used to open the non-WhatsApp targets (macOS app name)
JARVIS_BROWSER="Dia"
# Native macOS app for WhatsApp (falls back to the URL when uninstalled)
JARVIS_WHATSAPP_APP="WhatsApp"
JARVIS_GITHUB_URL="https://github.com/yashdev9274/supercli"
JARVIS_WHATSAPP_URL="https://web.whatsapp.com"
JARVIS_SLACK_URL="https://join.slack.com/t/supercodeai/shared_invite/zt-43enen35h-glS1qR854YB~HUg2AIW0vg"
JARVIS_LINEAR_URL="https://linear.app/supercodeai/projects/all"
JARVIS_TWITTER_URL="https://x.com"
# New Warp terminal tab opened at this folder (uses Warp's new_tab deep link)
JARVIS_WARP_DIR="/Users/yashdewasthale/dev/saas/supercli"
JARVIS_URLS=""

# ─── Dodo Payments ─────────────────────────────
# 🟡 Required for paid-tier billing (checkout, webhooks, refunds)
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
# ⚪ "test" to use test-mode product IDs in the seed; omit for live.
DODO_MODE=""
# Where Dodo redirects after checkout (used by the checkout route)
# Test: set to localhost or ngrok URL
# Live: https://supercode-terminal.vercel.app/studio?success=true
DODO_RETURN_URL="https://supercode-terminal.vercel.app/studio?success=true"
DODO_CANCEL_URL="https://supercode-terminal.vercel.app/studio?cancelled=true"
