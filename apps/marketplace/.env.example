# Vercel Integrations Console → your integration → Credentials
INTEGRATION_CLIENT_ID=oac_...
INTEGRATION_CLIENT_SECRET=...

# Public Base URL of this app (no trailing slash). Used as Marketplace Base URL.
# Example: https://marketplace.supercodeai.com
HOST=http://localhost:3010

# Same Postgres as apps/web (@super/db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Where SSO "Open in Supercode" should land after callback
SUPERCODE_APP_URL=http://localhost:3000

# Product slug registered in Vercel Create Product form
MARKETPLACE_PRODUCT_SLUG=supercode-review
