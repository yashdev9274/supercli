{
  "name": "supercode-cortex",
  "version": "0.1.0",
  "description": "Unified SDK for building AI agents with 8 gateway providers, 3 web search providers, 6 MCP platforms, and 3 voice providers",
  "license": "MIT",
  "author": "Yash Dewasthale",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashdev9274/supercli.git",
    "directory": "packages/cortex-sdk"
  },
  "bugs": {
    "url": "https://github.com/yashdev9274/supercli/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "gateway",
    "mcp",
    "web-search",
    "voice",
    "stt",
    "tts",
    "cli"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "supercode-cortex": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "import": "./dist/gateway/index.js"
    },
    "./agent-handler": {
      "types": "./dist/agent-handler/index.d.ts",
      "import": "./dist/agent-handler/index.js"
    },
    "./composio": {
      "types": "./dist/composio/index.d.ts",
      "import": "./dist/composio/index.js"
    },
    "./web-search": {
      "types": "./dist/web-search/index.d.ts",
      "import": "./dist/web-search/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./voice": {
      "types": "./dist/voice/index.d.ts",
      "import": "./dist/voice/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "build:cli": "tsup --config tsup.cli.config.ts",
    "prepublishOnly": "bun run build && bun run build:cli",
    "lint": "echo 'cortex-sdk lint pending'",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/mcp": "^2.0.30",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/provider": "^3.0.10",
    "@opentui/core": "^0.5.2",
    "context.dev": "^2.10.0",
    "vercel-minimax-ai-provider": "^0.0.2",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "@composio/core": "^0.13.1",
    "@modelcontextprotocol/sdk": "^1.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  }
}
