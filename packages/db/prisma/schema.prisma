// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Stable monorepo path — avoids bun multi-copy @prisma/client hash mismatch on Vercel
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Test {
  id   String @id @default(cuid())
  name String
}

model PublicReviewCache {
  key        String   @id
  inputHash  String
  status     String   @default("pending")
  leaseToken String?
  leaseUntil DateTime?
  expiresAt  DateTime
  markdown   String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
  @@index([status, leaseUntil])
  @@map("public_review_cache")
}

model PublicReviewQuota {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("public_review_quota")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  integrations             Integration[]
  repositories             Repository[]
  conversations            Conversation[]
  vercelInstallations      VercelInstallation[]
  memberships              OrganizationMembership[]
  externalInstallations    ExternalInstallation[]
  userDelegatedConnections UserDelegatedConnection[]
  agentSessions            AgentSession[]
  inboundEvents            InboundEvent[]
  outboxEvents             NovaOutboxEvent[]
  auditEvents              NovaAuditEvent[]
  usageLedger              NovaUsageLedger[]
  desktopDevices           DesktopDevice[]

  @@map("organization")
}

model User {
  id             String        @id
  name           String
  email          String
  emailVerified  Boolean       @default(false)
  image          String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sessions                Session[]
  accounts                Account[]
  respositories           Repository[]
  reviewRuns              ReviewRun[]
  reviewCreditPeriods     ReviewCreditPeriod[]
  reviewCreditEntries     ReviewCreditEntry[]
  whatsAppIdentities      WhatsAppIdentity[]
  whatsAppLinkChallenges  WhatsAppLinkChallenge[]
  organizationMemberships OrganizationMembership[]
  desktopDevices          DesktopDevice[]

  @@unique([email])
  @@index([organizationId])
  @@map("user")
}

model Repository {
  id             String        @id @default(cuid())
  githubId       BigInt        @unique
  name           String
  owner          String
  fullName       String
  url            String
  reviewSettings Json?         @map("review_settings")
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  reviews        Review[]
  reviewRuns     ReviewRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@map("repository")
}

model Review {
  id           String         @id @default(cuid())
  repositoryId String
  repository   Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  prNumber     Int
  prTitle      String
  prUrl        String
  review       String         @db.Text
  status       String         @default("completed") // completed, failed, pending
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  conversations      Conversation[]
  whatsAppDeliveries WhatsAppDelivery[]
  whatsAppActions    WhatsAppAction[]
  reviewRuns         ReviewRun[]

  @@unique([repositoryId, prNumber])
  @@index([repositoryId])
  @@map("review")
}

model ReviewRun {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  reviewId     String?
  review       Review?    @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  prNumber     Int
  headSha      String
  source       String
  status       String     @default("created") // created | reserved | running | completed | refunded
  attempt      Int        @default(0)
  failure      String?    @db.Text
  reservedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  refundedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  creditEntries ReviewCreditEntry[]

  @@unique([userId, repositoryId, prNumber, headSha])
  @@index([userId, createdAt])
  @@index([repositoryId, prNumber, createdAt])
  @@index([status, updatedAt])
  @@map("review_run")
}

model ReviewCreditPeriod {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  allocation   Int      @default(20)
  usedCredits  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries ReviewCreditEntry[]

  @@unique([userId, periodStart])
  @@index([userId, periodEnd])
  @@map("review_credit_period")
}

model ReviewCreditEntry {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodId       String
  period         ReviewCreditPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  reviewRunId    String
  reviewRun      ReviewRun          @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  kind           String // reservation | settlement | refund | adjustment
  quantity       Int
  idempotencyKey String             @unique
  source         String
  createdAt      DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([periodId, kind])
  @@index([reviewRunId, createdAt])
  @@map("review_credit_entry")
}

model NovaEarlyInvite {
  id            String    @id @default(cuid())
  name          String
  role          String
  email         String    @unique
  emailStatus   String    @default("pending") // pending | sent | failed
  resendEmailId String?
  emailSentAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
  @@map("nova_early_invite")
}

model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider String // "slack" | "linear"

  // Composio connection (tokens live in Composio; we store the account handle)
  composioConnectedAccountId String?
  composioEntityId           String? // typically organizationId

  // Display / preference fields (no secrets)
  slackTeamId    String?
  slackTeamName  String?
  slackChannelId String?
  linearTeamId   String?
  linearTeamName String?

  isActive  Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@index([composioConnectedAccountId])
  @@map("integration")
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider   String // "slack" | "linear"
  externalId String // Slack thread_ts or Linear issue/comment ID
  channelId  String?
  userId     String? // external user id who started the conversation

  reviewId String?
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider, externalId])
  @@index([organizationId])
  @@index([reviewId])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role       String // "user" | "assistant" | "system"
  content    String  @db.Text
  externalId String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("message")
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner | admin | member | guest
  status         String       @default("active") // invited | active | suspended
  capabilities   Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  externalIdentities      ExternalIdentity[]
  delegatedConnections    UserDelegatedConnection[]
  initiatedAgentSessions  AgentSession[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role])
  @@map("organization_membership")
}

model ExternalInstallation {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider           String // slack | linear | github | future connector slug
  externalAccountId  String
  externalAccountName String?
  botExternalUserId  String?
  status             String       @default("pending") // pending | active | permission_missing | unhealthy | revoked
  grantedScopes      Json?
  missingScopes      Json?
  webhookStatus      String       @default("pending") // pending | healthy | failing | disabled
  credentialRef      String? // encrypted secret-manager reference; never a raw token
  config             Json?
  installedAt        DateTime?
  lastHealthCheckAt  DateTime?
  lastEventAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  identities          ExternalIdentity[]
  delegatedConnections UserDelegatedConnection[]
  sessionSurfaces     SessionSurface[]
  inboundEvents       InboundEvent[]
  deliveryAttempts    DeliveryAttempt[]

  @@unique([organizationId, provider, externalAccountId])
  @@index([organizationId, provider, status])
  @@index([provider, externalAccountId])
  @@map("external_installation")
}

model UserDelegatedConnection {
  id                 String                 @id @default(cuid())
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membershipId       String
  membership         OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  installationId     String?
  installation       ExternalInstallation?  @relation(fields: [installationId], references: [id], onDelete: SetNull)
  provider           String
  externalAccountId  String
  grantedScopes      Json?
  credentialRef      String?
  status             String                 @default("active")
  expiresAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([membershipId, provider, externalAccountId])
  @@index([organizationId, provider, status])
  @@index([installationId])
  @@map("user_delegated_connection")
}

model ExternalIdentity {
  id                 String                 @id @default(cuid())
  membershipId       String
  membership         OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  installationId     String
  installation       ExternalInstallation   @relation(fields: [installationId], references: [id], onDelete: Cascade)
  provider           String
  externalUserId     String
  displayName        String?
  email              String?
  status             String                 @default("verified")
  verifiedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([installationId, externalUserId])
  @@index([membershipId, provider])
  @@map("external_identity")
}

model AgentSession {
  id                    String                  @id @default(cuid())
  organizationId        String
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  initiatorMembershipId String?
  initiatorMembership   OrganizationMembership? @relation(fields: [initiatorMembershipId], references: [id], onDelete: SetNull)
  objective             String                  @db.Text
  mode                  String                  @default("chat")
  status                String                  @default("active") // active | sleeping | completed | cancelled | failed
  policySnapshot        Json?
  contextVersion        Int                     @default(1)
  budget                Json?
  nextSequence          Int                     @default(1)
  activeRunId           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  completedAt           DateTime?

  surfaces       SessionSurface[]
  messages       AgentSessionMessage[]
  activities     AgentActivity[]
  runs           AgentRun[]
  inboundEvents  InboundEvent[]
  outboxEvents   NovaOutboxEvent[]
  artifacts      NovaArtifact[]
  auditEvents    NovaAuditEvent[]
  usageLedger    NovaUsageLedger[]

  @@index([organizationId, status, updatedAt])
  @@index([initiatorMembershipId])
  @@map("agent_session")
}

model SessionSurface {
  id                   String                @id @default(cuid())
  agentSessionId       String
  agentSession         AgentSession          @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)
  installationId       String?
  installation         ExternalInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  provider             String // desktop | slack | linear | github | web
  surfaceKey           String @unique // deterministic organization/provider/installation/surface identity
  externalSurfaceId    String
  externalContainerId  String?
  externalUrl          String?
  status               String                @default("active")
  lastInboundAt        DateTime?
  lastOutboundAt       DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  messages      AgentSessionMessage[]
  activities    AgentActivity[]
  inboundEvents InboundEvent[]

  @@index([provider, externalSurfaceId, installationId])
  @@index([agentSessionId, status])
  @@index([installationId])
  @@map("session_surface")
}

model AgentSessionMessage {
  id             String         @id @default(cuid())
  agentSessionId String
  agentSession   AgentSession   @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)
  surfaceId      String?
  surface        SessionSurface? @relation(fields: [surfaceId], references: [id], onDelete: SetNull)
  sequence       Int
  role           String
  content        String         @db.Text
  senderType     String?
  senderId       String?
  originEventId  String?
  externalId     String?
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@unique([agentSessionId, sequence])
  @@unique([surfaceId, externalId])
  @@index([agentSessionId, createdAt])
  @@map("agent_session_message")
}

model AgentActivity {
  id             String          @id @default(cuid())
  agentSessionId String
  agentSession   AgentSession    @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)
  surfaceId      String?
  surface        SessionSurface? @relation(fields: [surfaceId], references: [id], onDelete: SetNull)
  runId          String?
  run            AgentRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  sequence       Int
  type           String // acknowledgement | plan | action | approval_request | response | error | result
  status         String          @default("created")
  title          String?
  body           String?         @db.Text
  data           Json?
  visibility     String          @default("company")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  deliveryAttempts DeliveryAttempt[]

  @@unique([agentSessionId, sequence])
  @@index([runId, createdAt])
  @@map("agent_activity")
}

model InboundEvent {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installationId     String?
  installation       ExternalInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  agentSessionId     String?
  agentSession       AgentSession?         @relation(fields: [agentSessionId], references: [id], onDelete: SetNull)
  surfaceId          String?
  surface            SessionSurface?       @relation(fields: [surfaceId], references: [id], onDelete: SetNull)
  provider           String
  providerDeliveryId String
  eventType          String
  actorExternalId    String?
  payload            Json
  payloadVersion     String                 @default("1")
  verificationState  String                 @default("verified")
  status             String                 @default("pending") // pending | processing | completed | failed | ignored
  attempts           Int                    @default(0)
  error              String?                @db.Text
  receivedAt         DateTime               @default(now())
  processedAt        DateTime?
  updatedAt          DateTime               @updatedAt

  @@unique([provider, providerDeliveryId])
  @@index([status, receivedAt])
  @@index([organizationId, provider, eventType])
  @@map("inbound_event")
}

model AgentRun {
  id               String       @id @default(cuid())
  agentSessionId   String
  agentSession     AgentSession @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)
  parentRunId      String?
  status           String       @default("queued")
  executionTarget  String         @default("none") // none | desktop | remote_sandbox
  desktopDeviceId  String?
  desktopDevice    DesktopDevice? @relation(fields: [desktopDeviceId], references: [id], onDelete: SetNull)
  policySnapshot   Json?
  budget           Json?
  version          Int          @default(1)
  cancellationAt   DateTime?
  cancellationReason String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  activities       AgentActivity[]
  toolInvocations  ToolInvocation[]
  approvals        ApprovalRequest[]
  artifacts        NovaArtifact[]
  capabilityLeases CapabilityLease[]
  usageLedger      NovaUsageLedger[]

  @@index([agentSessionId, status, createdAt])
  @@index([desktopDeviceId, status])
  @@map("agent_run")
}

model ToolInvocation {
  id                 String       @id @default(cuid())
  runId              String
  run                AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  idempotencyKey     String       @unique
  toolName           String
  capability         String
  riskClass          String
  normalizedArgsHash String
  arguments          Json
  status             String       @default("pending")
  result              Json?
  error               String?      @db.Text
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  approvals ApprovalRequest[]

  @@index([runId, status, createdAt])
  @@map("tool_invocation")
}

model ApprovalRequest {
  id                   String          @id @default(cuid())
  runId                String
  run                  AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolInvocationId     String?
  toolInvocation       ToolInvocation? @relation(fields: [toolInvocationId], references: [id], onDelete: Cascade)
  approverMembershipId String?
  capability           String
  normalizedArgsHash   String
  status               String          @default("pending") // pending | approved | denied | expired | cancelled
  tokenHash            String?         @unique
  expiresAt            DateTime
  decidedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([runId, status])
  @@index([approverMembershipId, status])
  @@map("approval_request")
}

model NovaArtifact {
  id             String       @id @default(cuid())
  agentSessionId String
  agentSession   AgentSession @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)
  runId          String?
  run            AgentRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  type           String
  name           String
  uri            String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([agentSessionId, type, createdAt])
  @@index([runId])
  @@map("nova_artifact")
}

model DeliveryAttempt {
  id             String                @id @default(cuid())
  installationId String?
  installation   ExternalInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  activityId     String
  activity       AgentActivity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  idempotencyKey String                @unique
  provider       String
  status         String                @default("pending")
  externalId     String?
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?
  error          String?               @db.Text
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, nextAttemptAt])
  @@index([activityId])
  @@map("delivery_attempt")
}

model NovaOutboxEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentSessionId String?
  agentSession   AgentSession? @relation(fields: [agentSessionId], references: [id], onDelete: Cascade)
  topic          String
  idempotencyKey String       @unique
  payload        Json
  status         String       @default("pending")
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now())
  processedAt    DateTime?
  error          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([organizationId, topic])
  @@map("nova_outbox_event")
}

model NovaAuditEvent {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentSessionId String?
  agentSession   AgentSession? @relation(fields: [agentSessionId], references: [id], onDelete: SetNull)
  actorType      String
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  decision       String?
  reason         String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([agentSessionId, createdAt])
  @@map("nova_audit_event")
}

model NovaUsageLedger {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentSessionId String?
  agentSession   AgentSession? @relation(fields: [agentSessionId], references: [id], onDelete: SetNull)
  runId          String?
  run            AgentRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  kind           String
  quantity       Decimal       @db.Decimal(18, 6)
  unit           String
  reservationKey String?       @unique
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([runId, kind])
  @@map("nova_usage_ledger")
}

model DesktopDevice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  devicePublicId String       @unique
  displayName    String
  status         String       @default("offline")
  appVersion     String?
  publicKey      String?      @db.Text
  lastSeenAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspaceBindings WorkspaceBinding[]
  agentRuns         AgentRun[]
  capabilityLeases CapabilityLease[]

  @@index([organizationId, status, lastSeenAt])
  @@index([userId])
  @@map("desktop_device")
}

model WorkspaceBinding {
  id               String        @id @default(cuid())
  desktopDeviceId  String
  desktopDevice    DesktopDevice @relation(fields: [desktopDeviceId], references: [id], onDelete: Cascade)
  opaqueBindingId  String        @unique
  displayName      String
  repositoryFullName String?
  repositoryId     String?
  gitRemoteHash    String?
  status           String        @default("active")
  lastUsedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  capabilityLeases CapabilityLease[]

  @@index([desktopDeviceId, status])
  @@index([repositoryId])
  @@map("workspace_binding")
}

model CapabilityLease {
  id                 String           @id @default(cuid())
  runId              String
  run                AgentRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  desktopDeviceId    String
  desktopDevice      DesktopDevice    @relation(fields: [desktopDeviceId], references: [id], onDelete: Cascade)
  workspaceBindingId String
  workspaceBinding   WorkspaceBinding @relation(fields: [workspaceBindingId], references: [id], onDelete: Cascade)
  tokenHash          String           @unique
  capabilities       Json
  constraints        Json?
  status             String           @default("active")
  expiresAt          DateTime
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime         @default(now())

  @@index([runId, status])
  @@index([desktopDeviceId, expiresAt])
  @@map("capability_lease")
}

model WhatsAppIdentity {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumberId  String
  phoneE164      String?
  conversationId String?
  businessScopedUserId       String?
  parentBusinessScopedUserId String?
  username       String?
  verifiedAt     DateTime
  isActive       Boolean  @default(true)
  notifyReviews  Boolean  @default(true)
  lastActiveAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deliveries WhatsAppDelivery[]
  actions    WhatsAppAction[]

  @@unique([userId, phoneNumberId])
  @@unique([phoneNumberId, phoneE164])
  @@unique([phoneNumberId, businessScopedUserId])
  @@index([phoneNumberId, parentBusinessScopedUserId])
  @@index([conversationId])
  @@map("whatsapp_identity")
}

model WhatsAppLinkChallenge {
  id            String @id @default(cuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumberId String
  phoneE164     String
  codeHash      String
  expiresAt     DateTime
  consumedAt    DateTime?
  attempts      Int      @default(0)
  sendCount     Int      @default(1)
  windowStartedAt DateTime @default(now())
  requestIpHash String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, phoneNumberId, phoneE164, createdAt])
  @@index([expiresAt])
  @@map("whatsapp_link_challenge")
}

model WhatsAppWebhookEvent {
  id             String @id @default(cuid())
  idempotencyKey String @unique
  eventType      String
  payloadVersion String?
  phoneNumberId  String
  payload        Json
  status         String @default("pending") // pending | processing | completed | failed
  attempts       Int    @default(0)
  error          String? @db.Text
  processedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phoneNumberId, eventType])
  @@map("whatsapp_webhook_event")
}

model WhatsAppDelivery {
  id          String @id @default(cuid())
  reviewId    String
  review      Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  identityId  String
  identity    WhatsAppIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  templateName String
  messageId   String? @unique
  status      String  @default("queued") // queued | sent | delivered | read | failed
  attempts    Int     @default(0)
  errorCode   String?
  error       String? @db.Text
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([reviewId, identityId, templateName])
  @@index([identityId, status])
  @@map("whatsapp_delivery")
}

model WhatsAppAction {
  id                String @id @default(cuid())
  externalActionKey String @unique
  externalMessageId String?
  action            String
  status            String @default("pending") // pending | processing | completed | denied | failed
  identityId        String
  identity          WhatsAppIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  reviewId          String
  review            Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorized        Boolean?
  denialReason      String?
  githubReviewId    BigInt?
  error             String? @db.Text
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([reviewId, status])
  @@index([identityId, createdAt])
  @@map("whatsapp_action")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Vercel Marketplace native integration installation (Partner API).
model VercelInstallation {
  id              String  @id // Vercel installation id, e.g. icfg_...
  vercelAccountId String
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  accessToken     String? @db.Text
  tokenType       String?
  billingPlanId   String  @default("free")
  notification    Json?
  rawPayload      Json?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  resources VercelResource[]

  @@index([organizationId])
  @@index([vercelAccountId])
  @@map("vercel_installation")
}

/// Provisioned Supercode Review resource under a Vercel installation.
model VercelResource {
  id             String @id @default(cuid())
  installationId String
  installation   VercelInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  productId     String  @default("supercode-review")
  name          String
  status        String  @default("ready") // ready | pending | suspended | reseeding | error | uninstalled
  billingPlanId String  @default("free")
  metadata      Json?
  notification  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([installationId])
  @@index([productId])
  @@map("vercel_resource")
}
